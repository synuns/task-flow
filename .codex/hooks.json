{
  "description": "Maintain review-pending Codex session records across lifecycle events.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_hook.py\"",
            "timeout": 5,
            "statusMessage": "Creating pending session snapshot"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_hook.py\"",
            "timeout": 30,
            "statusMessage": "Updating pending session snapshot"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_hook.py\"",
            "timeout": 3,
            "statusMessage": "Updating session record state"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_hook.py\"",
            "timeout": 3,
            "statusMessage": "Closing pending session record"
          }
        ]
      }
    ]
  }
}
