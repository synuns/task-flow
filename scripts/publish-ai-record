#!/usr/bin/env python3
import argparse
import datetime
import importlib.util
import os
import sys
import tempfile
from pathlib import Path


DEFAULT_ROOT = Path(__file__).resolve().parents[1]


def load_hook_module(source_root, filename, module_name):
    hooks = source_root / ".codex" / "hooks"
    if str(hooks) not in sys.path:
        sys.path.insert(0, str(hooks))
    path = hooks / filename
    spec = importlib.util.spec_from_file_location(module_name, path)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_name = None
    try:
        with tempfile.NamedTemporaryFile(
            "w",
            encoding="utf-8",
            dir=str(path.parent),
            prefix=".reviewed-record-",
            suffix=".tmp",
            delete=False,
        ) as stream:
            temporary_name = stream.name
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_name, path)
        temporary_name = None
    finally:
        if temporary_name:
            try:
                Path(temporary_name).unlink()
            except OSError:
                pass


def reviewed_content(candidate, reviewer):
    stamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
    safe_reviewer = " ".join(reviewer.replace("`", "'").split())
    lines = candidate.splitlines()
    metadata = [
        "",
        "- Review status: `human-reviewed`",
        "- Reviewed by: `{}`".format(safe_reviewer),
        "- Reviewed at: `{}`".format(stamp),
    ]
    return "\n".join(lines[:1] + metadata + lines[1:]).rstrip() + "\n"


def update_usage(document, session_id):
    start = "<!-- reviewed-records:start -->"
    end = "<!-- reviewed-records:end -->"
    if document.count(start) != 1 or document.count(end) != 1:
        raise ValueError("AI_USAGE.md requires exactly one reviewed-record marker pair")
    start_position = document.index(start)
    end_position = document.index(end)
    if start_position >= end_position:
        raise ValueError("AI_USAGE.md reviewed-record markers are out of order")
    link = (
        "- [검토 완료 세션 `{0}`]"
        "(./artifacts/codex-session-{0}.md)".format(session_id)
    )
    managed = document[start_position + len(start) : end_position]
    if link in managed:
        return document
    return document[:end_position] + link + "\n" + document[end_position:]


def restore_artifact(path, previous):
    if previous is not None:
        atomic_write(path, previous)
        return
    try:
        path.unlink()
    except FileNotFoundError:
        pass


def restore_index(path, previous, indexer):
    if previous is not None:
        indexer.atomic_write_index(path, previous)
        return
    try:
        path.unlink()
    except FileNotFoundError:
        pass


def rollback_publication(
    index_path,
    previous_index,
    artifact_path,
    previous_artifact,
    indexer,
    restore_index_required=True,
    restore_artifact_required=True,
):
    failures = []
    if restore_index_required:
        try:
            restore_index(index_path, previous_index, indexer)
        except (OSError, UnicodeError, ValueError) as error:
            failures.append("index restore failed: {}".format(error))
    if restore_artifact_required:
        try:
            restore_artifact(artifact_path, previous_artifact)
        except (OSError, UnicodeError, ValueError) as error:
            failures.append("artifact restore failed: {}".format(error))
    if failures:
        raise ValueError(
            "rollback incomplete ({}); manual recovery required".format(
                "; ".join(failures)
            )
        )


def parse_args(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("session_id")
    parser.add_argument("--repo-root", type=Path, default=DEFAULT_ROOT)
    parser.add_argument("--reviewed-by", required=True)
    parser.add_argument("--confirm-sensitive-review", action="store_true")
    parser.add_argument("--confirm-content-review", action="store_true")
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    if not args.confirm_sensitive_review or not args.confirm_content_review:
        print("both human review confirmations are required", file=sys.stderr)
        return 2
    if not args.reviewed_by.strip():
        print("reviewer name is required", file=sys.stderr)
        return 2
    root = args.repo_root.resolve()
    exporter = load_hook_module(
        DEFAULT_ROOT,
        "export_session.py",
        "record_exporter",
    )
    indexer = load_hook_module(
        DEFAULT_ROOT,
        "render_artifact_index.py",
        "record_indexer",
    )
    session_id = exporter.safe_session_id(args.session_id)
    if session_id != args.session_id:
        print("unsafe session id", file=sys.stderr)
        return 2
    candidate_path = (
        root
        / ".codex"
        / "review-pending"
        / exporter.artifact_filename(session_id)
    )
    if not candidate_path.is_file():
        print("pending candidate not found", file=sys.stderr)
        return 1
    candidate = candidate_path.read_text(encoding="utf-8")
    if exporter.redact(candidate, Path("/__no_home_match__")) != candidate:
        print("candidate still contains a sensitive pattern", file=sys.stderr)
        return 1
    artifacts = root / "artifacts"
    destination = artifacts / exporter.artifact_filename(session_id)
    reviewed = reviewed_content(candidate, args.reviewed_by)
    if exporter.redact(reviewed, Path("/__no_home_match__")) != reviewed:
        print("reviewed record still contains a sensitive pattern", file=sys.stderr)
        return 1
    usage_path = root / "AI_USAGE.md"
    previous = None
    try:
        artifacts.mkdir(parents=True, exist_ok=True)
        with indexer.index_lock(artifacts / ".index.lock"):
            usage = usage_path.read_text(encoding="utf-8")
            updated_usage = update_usage(usage, session_id)
            index_path = artifacts / "index.md"
            filenames = indexer.list_published_artifact_names(
                index_path,
                artifacts,
            )
            previous_index = (
                index_path.read_text(encoding="utf-8")
                if index_path.is_file()
                else None
            )
            if destination.is_symlink():
                raise ValueError("artifact destination must not be a symlink")
            if destination.exists() and not destination.is_file():
                raise ValueError("artifact destination must be a regular file")
            if destination.is_file():
                previous = destination.read_text(encoding="utf-8")
            artifact_written = False
            index_written = False
            try:
                atomic_write(destination, reviewed)
                artifact_written = True
                filenames.append(destination.name)
                indexer.atomic_write_index(
                    index_path,
                    indexer.render_index(filenames),
                )
                index_written = True
                atomic_write(usage_path, updated_usage)
            except (OSError, UnicodeError, ValueError):
                rollback_publication(
                    index_path,
                    previous_index,
                    destination,
                    previous,
                    indexer,
                    restore_index_required=index_written,
                    restore_artifact_required=artifact_written,
                )
                raise
    except indexer.IndexLockTimeout:
        print("artifact index lock timeout", file=sys.stderr)
        return 1
    except (OSError, UnicodeError, ValueError) as error:
        print("publication failed: {}".format(error), file=sys.stderr)
        return 1
    print("published reviewed record: {}".format(destination.relative_to(root)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
